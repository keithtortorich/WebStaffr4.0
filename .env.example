# Copy to .env and fill in real values for local development.
# .env is gitignored -- never commit real secrets. See CREDENTIALS.md for
# what each variable does and how to get it.

GROK_API_KEY=
GHL_API_KEY=
GHL_LOCATION_ID=
RETELL_WEBHOOK_SECRET=
GHL_WEBHOOK_SECRET=
BOOK_API_KEY=

# SERVICETITAN_CLIENT_ID=
# SERVICETITAN_CLIENT_SECRET=
# SERVICETITAN_TENANT_ID=
# SERVICETITAN_ENABLED=false

# Local SQLite path (default: webstaffr.db in the repo root)
WEBSTAFFR_DB_PATH=./webstaffr.db

# Postgres/Supabase connection string -- set this to switch the app to the
# Postgres backend instead of SQLite. Leave unset for local dev.
# DATABASE_URL=

# Optional external TTS backend for /v1/audio/speech
# KOKORO_TTS_URL=
