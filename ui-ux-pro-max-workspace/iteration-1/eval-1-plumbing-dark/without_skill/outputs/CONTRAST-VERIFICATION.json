  "recommendations": {
    "do": [
      "Use white or light gray text on slate blue backgrounds",
      "Use gold accent for CTAs and focus indicators",
      "Combine error/success colors with icons (not color alone)",
      "Test all combinations before deployment",
      "Use semantic HTML with proper ARIA attributes",
      "Always include text labels with form inputs"
    ],
    "dont": [
      "Rely on color alone to convey meaning",
      "Use colors outside this tested palette without re-testing",
      "Reduce contrast for decorative purposes",
      "Use pale or desaturated variants without verification",
      "Assume custom colors match contrast levels"
    ]
  },
