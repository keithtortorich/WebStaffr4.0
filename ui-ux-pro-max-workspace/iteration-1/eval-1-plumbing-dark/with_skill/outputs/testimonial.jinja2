{# Testimonial Component
   Customer testimonial card with optional image and rating
   Usage: {% include 'components/testimonial.jinja2' with context %}
   Props: quote, author_name, author_title (optional), author_image (optional), rating (1-5, optional)
#}

<div class="bg-bg-secondary border border-border rounded-lg p-6 max-w-md">
  
  {# Star rating - only display if rating provided and no fabrication #}
  {% if rating and rating > 0 %}
  <div class="flex gap-1 mb-4">
    {% for i in range(1, 6) %}
      {% if i <= rating %}
      <span class="text-accent-primary text-lg" aria-hidden="true">★</span>
      {% else %}
      <span class="text-border text-lg" aria-hidden="true">★</span>
      {% endif %}
    {% endfor %}
    <span class="sr-only">{{ rating }} out of 5 stars</span>
  </div>
  {% endif %}
  
  {# Testimonial quote #}
  <blockquote class="text-fg-primary mb-4 leading-relaxed italic">
    "{{ quote }}"
  </blockquote>
  
  {# Author information #}
  <div class="flex items-center gap-3 pt-4 border-t border-border">
    {% if author_image %}
    <img 
      src="{{ author_image }}" 
      alt="{{ author_name }}"
      class="w-12 h-12 rounded-full object-cover"
      loading="lazy"
    />
    {% endif %}
    
    <div>
      <p class="font-semibold text-fg-primary text-sm">
        {{ author_name }}
      </p>
      {% if author_title %}
      <p class="text-fg-muted text-xs">
        {{ author_title }}
      </p>
      {% endif %}
    </div>
  </div>
  
</div>
