{# Service Card Component
   Reusable across WebStaffr customer sites
   Usage: {% include 'components/service_card.jinja2' with context %}
   Props: title, description, icon_url (optional), price (optional), action_url, variant (default | featured)
#}

<div class="card {% if variant == 'featured' %}border-2 border-accent-primary bg-accent-light{% else %}bg-bg-secondary{% endif %} p-6 rounded-lg transition-all duration-normal hover:shadow-lg">
  
  {% if icon_url %}
  <div class="mb-4">
    <img 
      src="{{ icon_url }}" 
      alt="{{ title }}" 
      class="w-12 h-12 rounded-md object-cover"
      loading="lazy"
    />
  </div>
  {% endif %}
  
  <h3 class="text-xl font-heading font-bold text-fg-primary mb-2">
    {{ title }}
  </h3>
  
  <p class="text-sm text-fg-muted leading-relaxed mb-4">
    {{ description }}
  </p>
  
  {% if price %}
  <div class="flex items-baseline gap-1 mb-4">
    <span class="text-3xl font-bold text-accent-primary">
      {{ price }}
    </span>
    {% if price_period %}
    <span class="text-sm text-fg-muted">
      / {{ price_period }}
    </span>
    {% endif %}
  </div>
  {% endif %}
  
  {% if action_url %}
  <a 
    href="{{ action_url }}" 
    class="inline-block w-full text-center bg-accent-primary hover:bg-accent-hover text-white font-semibold py-3 px-4 rounded-lg transition-colors duration-fast focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-primary"
    role="button"
  >
    {{ action_text or 'Learn More' }}
  </a>
  {% endif %}
  
</div>
